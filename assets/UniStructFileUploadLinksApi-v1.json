  "definitions": {
    "ErrorResponse": {
      "required": [
        "message"
      ],
      "type": "object",
      "properties": {
        "errorCode": {
          "format": "int32",
          "description": "קוד שגיאה",
          "maximum": 599,
          "minimum": 400,
          "type": "integer",
          "example": 400
        },
        "message": {
          "description": "הודעה",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[^<>]*$",
          "type": "string",
          "example": "Explanation of the error"
        }
      },
      "additionalProperties": false
    },
    "FileResponse": {
      "required": [
        "fileName",
        "fileUniqueId",
        "headers",
        "signUrl"
      ],
      "type": "object",
      "properties": {
        "fileName": {
          "description": "שם הקובץ",
          "maxLength": 50,
          "minLength": 1,
          "pattern": "^[^<>]*$",
          "type": "string",
          "example": "test"
        },
        "signUrl": {
          "description": "קישור",
          "maxLength": 1000,
          "minLength": 300,
          "pattern": "^https:\\/\\/storage\\.googleapis\\.com\\/([\\w\\-]+\\.)+[a-zA-Z]{2,6}(:\\d+)?(\\/[\\w\\-.,@?^=%&:/~+#]*)?(\\?[;&a-zA-Z0-9%_\\.=+\\-]*)?$",
          "type": "string",
          "example": "https://storage.googleapis.com/sign_url/"
        },
        "fileUniqueId": {
          "description": "מזהה יחודי לקובץ",
          "maxLength": 280,
          "minLength": 1,
          "pattern": "^[0-9a-fA-F]{12}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\\.txt$",
          "type": "string",
          "example": "145112142c50-e414-49c1-b293-4b91064864a9.txt"
        },
        "headers": {
          "description": "headers עבור שירות העלאה לענן",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "example": {
            "x-goog-content-length-range": "0,1048576",
            "x-goog-resumable": "start"
          }
        }
      },
      "additionalProperties": false
    },
    "InputRequest": {
      "required": [
        "caseNumber",
        "endPeriod",
        "startPeriod"
      ],
      "type": "object",
      "properties": {
        "caseNumber": {
          "format": "int32",
          "description": "מספר תיק\r\nניתן להשתמש במספר תיק 777777715 למקרה שאין דרישה לקובץ במבנה אחיד\r\nובתיק 777777749 לשגיאת gateway",
          "maximum": 999999999,
          "minimum": 1,
          "type": "integer",
          "example": 777777723
        },
        "startPeriod": {
          "description": "תחילת תקופה",
          "maxLength": 10,
          "minLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
          "example": "2025-05-05"
        },
        "endPeriod": {
          "description": "סיום תקופה",
          "maxLength": 10,
          "minLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
          "example": "2025-05-09"
        },
        "representorCompanyId": {
          "format": "int32",
          "description": "מזהה חברה של מייצג",
          "maximum": 999999999,
          "minimum": 1,
          "example": 777777728,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "SignedUrlResponse": {
      "required": [
        "uniqueId"
      ],
      "type": "object",
      "properties": {
        "uniqueId": {
          "description": "מזהה ייחודי",
          "maxLength": 21,
          "minLength": 21,
          "pattern": "^$|[0-9]+$",
          "type": "string"
        },
        "files": {
          "description": "קבצים",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileResponse"
          }
        }
      },
      "additionalProperties": false
    },
    "SignedUrlResponseGeneralResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/definitions/SignedUrlResponse"
        },
        "error": {
          "$ref": "#/definitions/ErrorResponse"
        }
      },
      "additionalProperties": false
    }
  },
