  "paths": {
    "/v1/UploadingFile/GetUrlsForUploadingFiles": {
      "post": {
        "tags": [
          "UploadingFile"
        ],
        "operationId": "GetUrlsForUploadingFiles",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/InputRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/SignedUrlResponseGeneralResponse"
            },
            "examples": {
              "application/json": {
                "success": true,
                "data": {
                  "uniqueId": "250818409889393295584",
                  "files": [
                    {
                      "fileName": "test",
                      "signUrl": "https://storage.googleapis.com/sign_url/",
                      "fileUniqueId": "145112142c50-e414-49c1-b293-4b91064864a9.txt"
                    }
                  ]
                },
                "error": null
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/SignedUrlResponseGeneralResponse"
            },
            "examples": {
              "application/json": {
                "data": null,
                "success": false,
                "error": {
                  "errorCode": 400,
                  "message": "Bad Request"
                }
              }
            }
          },
          "406": {
            "description": "Not Acceptable",
            "schema": {
              "$ref": "#/definitions/SignedUrlResponseGeneralResponse"
            },
            "examples": {
              "application/json": {
                "data": null,
                "success": false,
                "error": {
                  "errorCode": 406,
                  "message": "Not Acceptable"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "$ref": "#/definitions/SignedUrlResponseGeneralResponse"
            },
            "examples": {
              "application/json": {
                "data": null,
                "success": false,
                "error": {
                  "errorCode": 500,
                  "message": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
